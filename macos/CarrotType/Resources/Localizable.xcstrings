    "hotkey.push_to_talk_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the shortcut to record. Release to transcribe and paste. Without holding, a tap does not keep recording. Escape cancels without pasting; if live draft was showing, the status pill keeps it briefly so you can Copy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте сочетание, чтобы писать. Отпустите — распознать и вставить. Без удержания короткое нажатие не оставляет запись. Escape отменяет без вставки; если был черновик, плашка ненадолго остаётся — можно Скопировать."
          }
        }
      }
    },
    "hotkey.reset": {
