{
  "sourceLanguage": "ru",
  "strings": {
    "storage.legacy_path_rejected": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы не удалены: путь выходит за допустимую папку прежних моделей."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files were not removed: the path is outside the allowed retired-model folder."
          }
        }
      }
    },
    "storage.legacy_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалятся только файлы этой прежней модели. Ultra и модели форматирования сохранятся. Для возврата к прежней версии приложения может понадобиться повторное скачивание удалённой модели."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this retired model’s local files will be removed. Ultra and formatting models stay installed. Returning to an older app version may require downloading the removed model again."
          }
        }
      }
    },
    "storage.legacy_confirm": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить файлы «%@»?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@ files?"
          }
        }
      }
    },
    "storage.legacy_footer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти файлы больше не используются и не удаляются автоматически. Удаление необязательно. Для Apple показана только локальная отметка подготовки; системные speech-пакеты не удаляются."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files are no longer used and are never removed automatically. Removal is optional. Apple lists only the local preparation marker; shared system speech assets are not removed."
          }
        }
      }
    },
    "storage.legacy_section": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежние модели диктовки"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retired Dictation Models"
          }
        }
      }
    },
