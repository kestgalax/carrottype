    "language.footer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию — язык системы. Можно переопределить здесь."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to the system language. You can override it here."
          }
        }
