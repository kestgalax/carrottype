    "first_run.header": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome"
          }
        }
      }
    },
    "first_run.body": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная диктовка: горячая клавиша → запись → распознавание на устройстве → вставка у курсора. Аудио никуда не отправляется."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local dictation: hotkey → record → on-device recognition → paste at the caret. Audio never leaves your Mac."
          }
        }
      }
    },
    "first_run.continue": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        }
      }
    },
    "first_run.footer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачайте рекомендованную модель диктовки ниже и выдайте разрешения — статус Ready появится автоматически."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the recommended dictation model below and grant permissions — Ready appears automatically."
          }
        }
      }
    },
