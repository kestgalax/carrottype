    "recovery.memory_hint": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя диктовка хранится только в памяти до замены новой, очистки или выхода."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last dictation stays only in memory until replaced, cleared, or the app quits."
          }
        }
      }
    },
