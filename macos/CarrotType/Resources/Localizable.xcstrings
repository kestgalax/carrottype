    "hotkey.live_draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show text while you speak"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать текст, пока говорите"
          }
        }
      }
    },
    "hotkey.live_draft_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you speak, a preview appears in the status pill and can rephrase earlier words as context grows. Nothing is inserted until you stop. Escape keeps a Copy-able snapshot in the pill for a few seconds. Needs Parakeet. Off by default."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы говорите, в плашке статуса виден черновик: по мере речи он может уточнять уже сказанное. В документ ничего не попадёт, пока не остановите запись. Escape на несколько секунд оставляет в плашке снимок, который можно Скопировать. Нужен Parakeet. По умолчанию выключено."
          }
        }
      }
    },
    "hotkey.live_draft_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare Parakeet Ultra in Models to use live draft."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для живого текста подготовьте Parakeet Ultra в разделе «Модели»."
          }
        }
      }
    },
    "hotkey.offline_second_pass": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refine accuracy after you stop"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уточнить текст после остановки"
          }
        }
      }
    },
    "hotkey.offline_second_pass_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you stop, re-check the whole phrase for a more accurate result — usually a bit slower. Off by default: the live preview text is used as-is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После остановки ещё раз проверить всю фразу целиком — обычно точнее, но чуть дольше. По умолчанию выключено: в документ уходит текст из живого черновика."
          }
        }
      }
    },
