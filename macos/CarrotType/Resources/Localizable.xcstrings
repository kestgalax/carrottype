    "format.footer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart/Smart+ появляются в выборе режима только после скачивания пакета. Это пунктуация и лёгкое оформление текста после диктовки."
          }
