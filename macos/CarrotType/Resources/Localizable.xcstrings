      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст вставляется у курсора как обычно. Если фокус уйдёт в другое приложение, результат останется в буфере — его можно вставить ⌘V."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text still pastes at the caret. If focus moves to another app, the result stays on the clipboard so you can paste with ⌘V."
