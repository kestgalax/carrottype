    "permissions.accessibility_tip": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если в Системных настройках галочка уже стоит, а здесь статус не обновляется — удалите CarrotType из списка Универсального доступа и добавьте снова, затем обновите статус или перезапустите приложение."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Accessibility is already checked in System Settings but status here is stuck — remove CarrotType from the Accessibility list and add it again, then refresh status or restart the app."
          }
        }
      }
    },
