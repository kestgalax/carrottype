# Copy to a local path outside the repo (or fill in CI secrets). Do not commit real values.
# Used with macos/scripts/notarize-dmg.sh and ops/deploy.md (Developer ID + notarytool).

# Keychain profile name created by:
#   xcrun notarytool store-credentials "carrottype-notary" \
#     --apple-id "you@example.com" --team-id "TEAMID" --password "app-specific-password"
NOTARY_PROFILE=carrottype-notary

# Codesign identity for release builds (must match a Developer ID Application cert in Keychain):
SIGN_IDENTITY=Developer ID Application: Your Name (TEAMID)

# Optional — only if you prefer env-based notarytool instead of a Keychain profile:
# APPLE_ID=you@example.com
# TEAM_ID=TEAMID
# APP_SPECIFIC_PASSWORD=
